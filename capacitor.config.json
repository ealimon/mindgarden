{
  "appId": "com.limonmedia.mindgarden",
  "appName": "MindGarden",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "ios": {
    "minVersion": "16.0",
    "contentInset": "always",
    "allowsLinkPreview": false,
    "handleApplicationURL": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1800,
      "backgroundColor": "#FAF6EF",
      "showSpinner": false
    },
    "Keyboard": {
      "resize": "body",
      "style": "light"
    }
  }
}
